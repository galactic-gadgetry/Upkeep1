<UserControl x:Class="Upkeep1.UIComponents.Layout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Upkeep1.UIComponents"
             xmlns:view="clr-namespace:Upkeep1.Views"
             xmlns:vm="clr-namespace:Upkeep1.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- #Navigation Bar -->
                <ContentControl Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Content="{Binding CurrentNavigationBarViewModel}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:NavigationBarViewModel}">
                            <local:NavigationBar/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
                
                <!--- #Main Content -->
                <Grid Grid.Column="1" Grid.Row="0">
                    <ScrollViewer Content="{Binding CurrentContentViewModel}">
                        <ScrollViewer.Resources>
                            <DataTemplate DataType="{x:Type vm:DailyTimesheetViewModel}">
                                <view:DailyTimesheetView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
                                <view:ProjectsView/>
                            </DataTemplate>
                        </ScrollViewer.Resources>
                    </ScrollViewer>
                </Grid>
                
                <!-- # Side Content -->
                <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2">
                    <ContentControl Content="{Binding CurrentSideContentViewModel}">
                        
                    </ContentControl>
                </Grid>

                        <!-- #Info Bar -->
                <Label Background="DarkGray"
                    Grid.Column="1" Grid.Row="1"
                    Content="Info Bar placeholder."/>
            </Grid>
            
        </Border>
    </Grid>
</UserControl>
