<UserControl x:Class="Upkeep1.UIComponents.Layout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Upkeep1.UIComponents"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- #Navigation Bar -->
                <Label
                    Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                    Content="Navigation Bar placeholder."/>
                
                <!--- #Main Content -->
                <Label Background="LightGray"
                    Grid.Column="1" Grid.Row="0"
                    Content="Main Content placeholder."/>
                
                <!-- # Side Content -->
                <Label Background="Gray"
                    Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                    Content="Side Content placeholder."/>
                
                <!-- #Info Bar -->
                <Label Background="DarkGray"
                    Grid.Column="1" Grid.Row="1"
                    Content="Info Bar placeholder."/>
            </Grid>
            
        </Border>
    </Grid>
</UserControl>
