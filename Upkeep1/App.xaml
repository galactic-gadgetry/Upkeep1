<Application x:Class="Upkeep1.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Upkeep1">
    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UpkeepUI;component/UpkeepUI.xaml"/>

                <ResourceDictionary Source="Resources/Dictionaries/Buttons.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/Images.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/Palette.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/TextControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
         
    </Application.Resources>
</Application>
